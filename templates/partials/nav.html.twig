<header>
    <div class="wrap nav">
        <!-- Logo: links back to homepage -->
        <a href="/" class="logo">
            <img src="{{ asset('assets/logo/g4.png') }}" alt="Streamlist icon">
            <span class="logo-text">Streamlist</span>
        </a>

        <!-- Main navigation links -->
        <nav class="nav-links">
            <a href="/movies">Trending</a>
            <a href="/genres">Genres</a>
            <a href="/pricing">Pricing</a>
            <a href="/about">About</a>
        </nav>

        {% if app.user %}
            <form class="nav-search" method="get" action="{{ path('app_search') }}">
                <input type="search" name="q" placeholder="Search movies..." required
                    value="{{ app.request.query.get('q') }}">
                <button type="submit">Go</button>
            </form>
        {% endif %}

        
        <div class="nav-auth">
            {% if app.user %}
                {# Same canonical check as MovieController / WatchlistController:
                   tier = premium (unexpired) UNION an approved subscription row.
                   The old `app.user.tier == 'premium'` string compare showed
                   "Upgrade" to subscribed members whose plan name never got
                   dual-written into users.tier — and a ★ PLUS badge to expired
                   ones. Both were wrong. #}
                {% set is_premium = premium_access.hasPremiumAccess(app.user) %}
                {% if is_premium %}
                    <span class="plus-badge">★ PLUS</span>
                {% else %}
                    <a href="{{ path('app_pricing') }}" class="upgrade-link">Upgrade</a>
                {% endif %}

                <div class="profile-menu">
                    <button type="button" class="profile-btn">
                        <span class="profile-avatar">
                            {% if app.user.avatarPath is defined and app.user.avatarPath %}
                                <img src="{{ asset(app.user.avatarPath) }}" alt="">
                            {% else %}
                                {{ app.user.name|first|upper }}
                            {% endif %}
                        </span>
                        <span class="profile-name">{{ app.user.name }}</span>
                        <span class="profile-caret">▾</span>
                    </button>

                    <div class="profile-dropdown">
                        <div class="profile-dropdown-header">
                            <p class="profile-dropdown-name">{{ app.user.name }}</p>
                            <p class="profile-dropdown-email">{{ app.user.email }}</p>
                            {# effective tier: say what the app actually grants,
                               not the possibly-stale raw column word #}
                            <p class="profile-dropdown-tier">{{ is_premium ? 'premium' : app.user.tier }} member</p>
                        </div>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_admin_dashboard') }}" class="profile-dropdown-item">Admin</a>
                        {% endif %}
                        <a href="{{ path('app_profile') }}" class="profile-dropdown-item">Profile</a>
                        <a href="{{ path('app_watchlist') }}" class="profile-dropdown-item">My Watchlist</a>
                        <a href="{{ path('app_pricing') }}" class="profile-dropdown-item">Subscription</a>
                        <a href="{{ path('app_logout') }}" class="profile-dropdown-item profile-dropdown-logout">Log Out</a>
                    </div>
                </div>
            {% else %}
                <a href="{{ path('app_login') }}" class="login">Log In</a>
            {% endif %}
        </div>
    </div>
</header>
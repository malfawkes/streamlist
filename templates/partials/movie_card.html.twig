<div class="card">
    <div class="card-image">
        <img src="{{ movie.posterPath
                ? 'https://image.tmdb.org/t/p/w342' ~ movie.posterPath
                : asset('assets/img/canvas.png') }}"
             alt="Poster for {{ movie.title }}">
    </div>
    <p class="card-title"><a href="{{ path('app_movie_show', {id: movie.id}) }}">{{ movie.title }}</a></p>
    <p>
        {{ movie.releaseDate ? movie.releaseDate|date('Y') : 'TBA' }}
        {% if movie.rating and movie.rating > 0 %}
            | ★ {{ movie.rating|number_format(1) }}
        {% endif %}
    </p>
    {% if movie.isPremium %}
        <p class="premium-badge">★ PREMIUM</p>
    {% endif %}

    {% set in_watchlist = false %}
    {% if app.user %}
        {% for item in app.user.watchlistItems %}
            {% if item.movie.id == movie.id %}{% set in_watchlist = true %}{% endif %}
        {% endfor %}
    {% endif %}

    {% if app.user %}
        {% if in_watchlist %}
            <form method="post" action="{{ path('app_watchlist_remove', {id: movie.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('watchlist_remove_' ~ movie.id) }}">
                <button type="submit">Remove</button>
            </form>
        {% else %}
            <form method="post" action="{{ path('app_watchlist_add', {id: movie.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('watchlist_add_' ~ movie.id) }}">
                <button type="submit">+ Watchlist</button>
            </form>
        {% endif %}
    {% endif %}
</div>
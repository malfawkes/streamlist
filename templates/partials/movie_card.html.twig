<div class="card">
    <div class="card-image">
        <img src="{{ movie.posterPath
                ? 'https://image.tmdb.org/t/p/w342' ~ movie.posterPath
                : asset('assets/img/canvas.png') }}"
             alt="Poster for {{ movie.title }}">
    </div>
    <p class="card-title"><a href="{{ path('app_movie_show', {id: movie.id}) }}">{{ movie.title }}</a></p>
    <p>
        {{ movie.releaseDate ? movie.releaseDate|date('Y') : 'TBA' }}
        {% if movie.rating and movie.rating > 0 %}
            | ★ {{ movie.rating|number_format(1) }}
        {% endif %}
    </p>
    {% if movie.isPremium %}
        <p class="premium-badge">★ PREMIUM</p>
    {% endif %}

    {% if app.user %}
        {% set in_watchlist = watchlist_ids is defined and movie.id in watchlist_ids %}
        {% if movie.isPremium and not premium_access.hasPremiumAccess(app.user) %}
            {# premium lock — same rule as WatchlistController::add (the real
               gate is server-side); here we just stop offering a doomed button #}
            <a href="{{ path('app_pricing') }}" class="upgrade-link">★ Premium — upgrade to add</a>
        {% elseif in_watchlist %}
            <form method="post"
                  action="{{ path('app_watchlist_remove', {id: movie.id}) }}"
                  onsubmit="return confirm('Remove this movie from your watchlist?');">
                <input type="hidden" name="_token"
                       value="{{ csrf_token('watchlist_remove_' ~ movie.id) }}">
                <button type="submit">✓ In watchlist — remove</button>
            </form>
        {% else %}
            <form method="post"
                  action="{{ path('app_watchlist_add', {id: movie.id}) }}">
                <input type="hidden" name="_token"
                       value="{{ csrf_token('watchlist_add_' ~ movie.id) }}">
                <button type="submit">+ Watchlist</button>
            </form>
        {% endif %}
    {% endif %}
</div>
{% extends 'base.html.twig' %}

{% block title %}Pricing — StreamList{% endblock %}

{% block body %}
<div class="pr-page">
    <header class="pr-header">
        <h1>Plans &amp; Pricing</h1>
        <p>One request, one approval, done. Your watchlist cap thanks you in advance.</p>
    </header>

    <div class="pr-grid">
        {% for plan in plans %}
            <article class="pr-card{% if loop.last %} pr-card--featured{% endif %}">
                <h2 class="pr-card__name">{{ plan.name }}</h2>

                <p class="pr-card__price">
                    {{ plan.price }}
                    {% if plan.durationDays %}
                        <span class="pr-card__per">/ {{ plan.durationDays }} days</span>
                    {% endif %}
                </p>

                {% if plan.description %}
                    <p class="pr-card__desc">{{ plan.description }}</p>
                {% endif %}

                <div class="pr-card__cta">
                    {% if not app.user %}
                        <a href="{{ path('app_login') }}" class="pr-card__btn">Log in to upgrade</a>
                    {% elseif pending_plan_id == plan.id %}
                        <span class="pr-card__pending">Pending approval</span>
                    {% else %}
                        <form method="post"
                              action="{{ path('app_upgrade_request', {id: plan.id}) }}">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('upgrade_' ~ plan.id) }}">
                            <button type="submit" class="pr-card__btn">Upgrade</button>
                        </form>
                    {% endif %}
                </div>
            </article>
        {% else %}
            <p class="pr-empty">No plans configured yet.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}
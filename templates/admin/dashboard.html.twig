{% extends 'admin/base.html.twig' %}

{% block title %}Admin — StreamList{% endblock %}

{% block admin_content %}
<header class="adm-header">
    <h1>Dashboard</h1>
    <p class="adm-sub">Everything happening across StreamList, at a glance.</p>
</header>

<div class="adm-stats">
    <div class="adm-stat">
        <span class="adm-stat__label">Users</span>
        <span class="adm-stat__value">{{ stats.users }}</span>
    </div>

    <div class="adm-stat">
        <span class="adm-stat__label">Movies</span>
        <span class="adm-stat__value">{{ stats.movies }}</span>
    </div>

    <div class="adm-stat">
        <span class="adm-stat__label">Genres</span>
        <span class="adm-stat__value">{{ stats.genres }}</span>
    </div>

    <div class="adm-stat">
        <span class="adm-stat__label">Watchlist adds</span>
        <span class="adm-stat__value">{{ stats.watchlist_adds }}</span>
    </div>

    <div class="adm-stat{% if stats.pending_subscriptions > 0 %} adm-stat--attention{% endif %}">
        <span class="adm-stat__label">Pending upgrades</span>
        <span class="adm-stat__value">{{ stats.pending_subscriptions }}</span>
    </div>
</div>
{% endblock %}
{% extends 'admin/base.html.twig' %}

{% block admin_content %}

<div class="adm-stats">
    <a class="adm-stat" href="{{ path('app_admin_users') }}">
        <div class="adm-stat__num">{{ stats.users }}</div>
        <div class="adm-stat__label">Users</div>
    </a>
    <a class="adm-stat" href="{{ path('app_admin_movies') }}">
        <div class="adm-stat__num">{{ stats.movies }}</div>
        <div class="adm-stat__label">Movies</div>
    </a>
    <div class="adm-stat">
        <div class="adm-stat__num">{{ stats.genres }}</div>
        <div class="adm-stat__label">Genres</div>
    </div>
    <div class="adm-stat">
        <div class="adm-stat__num">{{ stats.watchlist }}</div>
        <div class="adm-stat__label">Watchlist adds</div>
    </div>
    <a class="adm-stat{{ stats.pending > 0 ? ' adm-stat--attention' }}" href="#adm-pending">
        <div class="adm-stat__num">{{ stats.pending }}</div>
        <div class="adm-stat__label">Pending requests</div>
    </a>
</div>

<div class="adm-grid2">
    <section class="adm-panel" id="adm-pending">
        <h2>Pending upgrade requests</h2>
        {% if pending_rows %}
        <table class="adm-table">
            <thead><tr><th>User</th><th>Plan</th><th style="text-align:right">Decision</th></tr></thead>
            <tbody>
            {% for row in pending_rows %}
                <tr>
                    <td>{{ row.user_name }}</td>
                    <td>{{ row.plan_name }}</td>
                    <td>
                        <div class="adm-inline" style="justify-content:flex-end">
                            <form method="post" action="{{ path('app_admin_pending_approve', {id: row.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('sub_approve_' ~ row.id) }}">
                                <button class="adm-btn adm-btn--solid">Approve</button>
                            </form>
                            <form method="post" action="{{ path('app_admin_pending_reject', {id: row.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('sub_reject_' ~ row.id) }}">
                                <button class="adm-btn adm-btn--danger">Reject</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% else %}
            <p class="adm-empty">Nothing pending. Inbox zero.</p>
        {% endif %}
    </section>

    <section class="adm-panel">
        <h2>Newest users</h2>
        {% if recent_users %}
        <ul class="adm-list">
            {% for u in recent_users %}
                <li><span>{{ u.name ?? u.email }}</span><span class="adm-muted">{{ u.email }}</span></li>
            {% endfor %}
        </ul>
        <p class="adm-muted" style="margin:10px 0 0">
            <a class="adm-link" href="{{ path('app_admin_users') }}">Manage users &rarr;</a>
        </p>
        {% else %}
            <p class="adm-empty">No users yet.</p>
        {% endif %}
    </section>
</div>

<section class="adm-panel">
    <h2>Latest watchlist adds</h2>
    {% if recent_adds %}
    <table class="adm-table">
        <thead><tr><th>User</th><th>Added</th></tr></thead>
        <tbody>
        {% for add in recent_adds %}
            <tr>
                <td>{{ add.uname }}</td>
                <td><a class="adm-link" href="{{ path('app_movie_show', {id: add.mid}) }}">{{ add.mtitle }}</a></td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% else %}
        <p class="adm-empty">No watchlist activity yet.</p>
    {% endif %}
</section>
{% endblock %}
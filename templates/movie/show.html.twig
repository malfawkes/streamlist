{% extends 'base.html.twig' %}

{% block title %}{{ movie.title }} — StreamList{% endblock %}

{% block body %}
<article class="md-page">
    <section
        class="md-hero{% if not movie.backdropPath %} md-hero--empty{% endif %}"
        {% if movie.backdropPath %}
            style="background-image: url('https://image.tmdb.org/t/p/w1280{{ movie.backdropPath }}')"
        {% endif %}
    >
        <div class="md-hero__scrim">
            <div class="md-hero__content">
                <h1>{{ movie.title }}</h1>

                <p class="md-hero__meta">
                    <span class="md-hero__rating">★ {{ movie.rating }}</span>
                    {% if movie.releaseDate %}
                        <span>{{ movie.releaseDate|date('Y') }}</span>
                    {% endif %}
                </p>

                <div class="md-hero__genres">
                    {% for genre in movie.genres %}
                        <span class="md-hero__chip">{{ genre.name }}</span>
                    {% else %}
                        <span class="md-hero__chip md-hero__chip--muted">Uncategorized</span>
                    {% endfor %}
                </div>

                {% if app.user %}
                    <form action="{{ path(watchlist_action, {id: movie.id}) }}" method="post" class="md-hero__cta">
                        <input type="hidden" name="_token" value="{{ watchlist_token }}">
                        <button type="submit">
                            {{ in_watchlist ? 'Remove from watchlist' : '+ Add to watchlist' }}
                        </button>
                    </form>
                {% else %}
                    <a href="{{ path('app_login') }}" class="md-hero__login">Log in to add to your watchlist</a>
                {% endif %}
            </div>
        </div>
    </section>

    <div class="md-body">
        <aside class="md-poster">
            {% if movie.posterPath %}
                <img
                    src="https://image.tmdb.org/t/p/w342{{ movie.posterPath }}"
                    alt="{{ movie.title }} poster"
                >
            {% else %}
                <div class="md-poster--empty">No poster available</div>
            {% endif %}

            <div class="md-facts">
                <h3>Details</h3>
                <dl>
                    <dt>Release date</dt>
                    <dd>{{ movie.releaseDate ? movie.releaseDate|date('F j, Y') : 'TBA' }}</dd>

                    <dt>Rating</dt>
                    <dd>{{ movie.rating ? '★ ' ~ movie.rating ~ ' / 10' : 'Not rated yet' }}</dd>

                    <dt>Genres</dt>
                    <dd>{{ movie.genres|length ? movie.genres|map(g => g.name)|join(', ') : 'Uncategorized' }}</dd>
                </dl>
            </div>
        </aside>

        <div class="md-info">
            <section class="md-card">
                <h2>Overview</h2>
                <p class="md-overview">
                    {{ movie.overview ?: 'No overview available yet.' }}
                </p>
            </section>

            {% if movie.trailerKey %}
                <section class="md-card">
                    <h2>Trailer</h2>
                    <div class="md-trailer">
                        <iframe
                            src="https://www.youtube.com/embed/{{ movie.trailerKey }}"
                            title="{{ movie.title }} trailer"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen
                        ></iframe>
                    </div>
                </section>
            {% endif %}
        </div>
    </div>
</article>
{% endblock %}